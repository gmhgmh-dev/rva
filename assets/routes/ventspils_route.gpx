<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="VentspilsVoiceAssistant" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Ventspils Testa Brauciens</name>
    <desc>Testa maršruts pa Ventspils ielām ar ātruma ierobežojumu un vienvirziena ielu trigeriem</desc>
  </metadata>
  <trk>
    <name>Ventspils 4-Trigeru Testa Brauciens</name>
    <trkseg>
      <!-- POSMS 1: Lielais prospekts - Sākums (Atļautais ātrums 50 km/h, Divvirzienu) -->
