      <!-- POSMS 4: Pagrieziens uz Platā iela - Izbraukšana no vienvirziena ielas -->
      <!-- TRIGERIS 4: Vienvirziena iela ir beigusies. -->
      <trkpt lat="57.397200" lon="21.555500">
        <name>Platā iela (Divvirzienu posms)</name>
